from motor_aposta.module.aposta.repositories.tipo_jogo_repository import tipo_jogo_repository


def __init__(cls):
    pass


async def lista_tipo_jogo() -> dict:
    lista = tipo_jogo_repository.lista_tipo_jogo()
    return lista


async def lista_tipo_jogo_por_id(id_tipo_jogo: int) -> dict:
    lista = tipo_jogo_repository.lista_tipo_jogo_id(id_tipo_jogo)

    if lista is None:
        return {"data": []}

    return {
        "data": {
            "id_tipo_jogo": lista.id_tipo_jogo,
            "nm_tipo_jogo": lista.nm_tipo_jogo,
            "qt_dezena_resultado": lista.qt_dezena_resultado,
            "qt_dezena_minima_aposta": lista.qt_dezena_minima_aposta,
            "qt_dezena_maxima_aposta": lista.qt_dezena_maxima_aposta,
            "nm_route": lista.nm_route,
            "nr_concurso_max": getattr(lista, "nr_concurso_max", None),
        }
    }


async def lista_tipo_jogo_estrutura(id_tipo_jogo: int) -> dict:
    lista = tipo_jogo_repository.busca_tipo_jogo_estrutura(id_tipo_jogo)

    if lista is None:
        return {"data": []}

    return {
        "data": [
            {
                "id_tipo_jogo": item.id_tipo_jogo,
                "nr_estrutura_jogo": item.nr_estrutura_jogo,
                "flg_centro_moldura": item.flg_centro_moldura,
            }
            for item in lista
        ]
    }
